CONFIG_IDF_TARGET="esp32s3"

# 1 ms FreeRTOS tick (default 10 ms): long IR spaces are timed more precisely.
# Recommended by the IRremoteIDF documentation.
CONFIG_FREERTOS_HZ=1000

# The 38 kHz IR carrier is generated by the LEDC peripheral instead of the CPU,
# giving a clean square wave that is not disturbed by interrupts.
CONFIG_IRREMOTE_TX_HW_CARRIER=y

# WiFi, web server and mDNS make the firmware larger than the default 1 MB
# app partition: this one is 1500 KB, with the settings (NVS) where they were.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
